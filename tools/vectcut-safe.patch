+"""Teste ponta-a-ponta do vectcut-safe VIA PROTOCOLO MCP (stdio), como o Claude usará.
+
+Sobe o servidor num subprocesso, conversa por stdio com o cliente oficial do
+pacote `mcp` e roda o job sintético completo da Fase 4 + os testes negativos
+de segurança. Qualquer falha = exit 1.
+"""
+import asyncio
+import json
+import os
+import shutil
+import sys
+
+from mcp import ClientSession, StdioServerParameters
+from mcp.client.stdio import stdio_client
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ROOT = os.environ.get("VIDEO_FACTORY_ROOT", r"D:\VIDEO-FACTORY")
+PYTHON = os.path.join(REPO, ".venv", "Scripts", "python.exe")
+MEDIA = os.path.join(ROOT, "media", "test")
+
+FERRAMENTAS_ESPERADAS = {
+    "create_draft", "add_video_local", "add_audio_local", "add_image_local",
+    "add_text", "add_subtitle_local", "add_dynamic_captions", "add_effect",
+    "add_keyframes", "inspect_media", "save_draft_to_staging", "validate_draft",
+    "publish_draft_to_capcut",
+}
+
+FALHAS = []
+
+
+def checar(nome, cond, detalhe=""):
+    if cond:
+        print(f"  ok  {nome}")
+    else:
+        FALHAS.append(nome)
+        print(f"FALHA {nome} {detalhe}")
+
+
+def parse(resultado):
+    texto = "".join(c.text for c in resultado.content if getattr(c, "text", None))
+    try:
+        return json.loads(texto)
+    except Exception:
+        return {"_bruto": texto}
+
+
+async def main():
+    env = dict(os.environ)
+    env.update({
+        "VIDEO_FACTORY_ROOT": ROOT,
+        "MEDIA_ROOT": os.path.join(ROOT, "media"),
+        "STAGING_ROOT": os.path.join(ROOT, "staging"),
+        "NETWORK_DISABLED": "1",
+        "UPLOAD_DISABLED": "1",
+    })
+    env.pop("SAFE_CAPCUT_DRAFT_ROOT", None)  # publish DEVE estar travado nesta fase
+
+    params = StdioServerParameters(
+        command=PYTHON, args=[os.path.join(REPO, "mcp_server_safe.py")], env=env,
+    )
+    async with stdio_client(params) as (read, write):
+        async with ClientSession(read, write) as sessao:
+            await sessao.initialize()
+
+            # 1. allowlist exata — nada de ferramenta cloud/HTTP
+            ferramentas = {t.name for t in (await sessao.list_tools()).tools}
+            checar("allowlist exata de 13 ferramentas", ferramentas == FERRAMENTAS_ESPERADAS,
+                   f"(veio: {sorted(ferramentas)})")
+
+            async def chamar(nome, **args):
+                return parse(await sessao.call_tool(nome, args))
+
+            # 2. job sintético completo
+            r = await chamar("create_draft")
+            checar("create_draft", r.get("ok") is True, str(r))
+            did = r.get("draft_id", "")
+            checar("draft_id no formato VF_", did.startswith("VF_"))
+
+            v = os.path.join(MEDIA, "video-teste.mp4")
+            r = await chamar("add_video_local", path=v, draft_id=did, start=0.5, end=4.5, volume=0.9)
+            checar("vídeo local com corte e volume", r.get("ok") is True, str(r))
+
+            r = await chamar("add_image_local", path=os.path.join(MEDIA, "imagem-teste.png"),
+                             draft_id=did, start=1.0, end=3.0, scale_x=0.5, scale_y=0.5)
+            checar("imagem local", r.get("ok") is True, str(r))
+
+            r = await chamar("add_audio_local", path=os.path.join(MEDIA, "audio-teste.wav"),
+                             draft_id=did, volume=0.6)
+            checar("trilha de áudio local", r.get("ok") is True, str(r))
+
+            r = await chamar("add_text", text="Texto simples de teste", start=0.2, end=2.0,
+                             draft_id=did, font_size=9.0)
+            checar("texto simples", r.get("ok") is True, str(r))
+
+            r = await chamar("add_text", text="Texto com sombra e borda", start=2.2, end=4.0,
+                             draft_id=did, border_width=12.0, border_color="#000000",
+                             font_color="#FFD700", shadow_enabled=True, track_name="text_b")
+            checar("texto com múltiplos estilos", r.get("ok") is True, str(r))
+
+            r = await chamar("add_effect", draft_id=did, effect_type="效果不存在测试",
+                             effect_category="scene", start=0, end=1)
+            checar("efeito inexistente vira erro CLARO (não silencioso)",
+                   r.get("ok") is False and "catálogo" in r.get("mensagem", ""), str(r))
+
+            r = await chamar("add_keyframes", draft_id=did, track_name="main",
+                             property_type="alpha",
+                             keyframes=[{"time": 0.0, "value": "1.0"}, {"time": 2.0, "value": "0.3"}])
+            checar("keyframes", r.get("ok") is True, str(r))
+
+            r = await chamar("add_subtitle_local", srt_path=os.path.join(MEDIA, "legenda-teste.srt"),
+                             draft_id=did)
+            checar("SRT local", r.get("ok") is True, str(r))
+
+            with open(os.path.join(MEDIA, "palavras-teste.json"), encoding="utf-8") as f:
+                palavras = json.load(f)
+            r = await chamar("add_dynamic_captions", draft_id=did, words=palavras)
+            checar("legenda dinâmica por páginas", r.get("ok") is True and r.get("paginas", 0) >= 2, str(r))
+
+            # Régua de tamanho calibrada no CapCut na Fase 6 (14/08/2026): o aprovador
+            # pediu tamanho VARIÁVEL para dar dinamismo às frases de destaque, e o
+            # tamanho 60 com 8 caracteres estourou a tela — daí o aviso de largura.
+            destaque = [
+                {"text": "sao", "start": 0.0, "end": 0.3, "emphasis": "normal"},
+                {"text": "cinco", "start": 0.3, "end": 0.7, "emphasis": "keyword"},
+                {"text": "pares.", "start": 0.7, "end": 1.1, "emphasis": "normal"},
+                {"text": "Compre", "start": 1.2, "end": 1.6, "emphasis": "normal"},
+                {"text": "hoje.", "start": 1.6, "end": 2.0, "emphasis": "normal"},
+            ]
+            r = await chamar("add_dynamic_captions", draft_id=did, words=destaque,
+                             track_name="captions_destaque", font_size=9, font_size_destaque=25)
+            checar("página com keyword sai no tamanho de destaque",
+                   r.get("ok") is True and r.get("paginas_em_destaque", 0) == 1, str(r))
+
+            r = await chamar("add_text", draft_id=did, text="texto muito longo que estoura",
+                             start=0, end=1, font_size=60, track_name="texto_estoura")
+            checar("texto largo demais devolve aviso de largura",
+                   r.get("ok") is True and "aviso" in r, str(r))
+
+            r = await chamar("add_text", draft_id=did, text="cabe", start=1, end=2,
+                             font_size=7, track_name="texto_cabe")
+            checar("texto pequeno NÃO gera aviso falso",
+                   r.get("ok") is True and "aviso" not in r, str(r))
+
+            r = await chamar("inspect_media", path=v)
+            checar("inspect_media", r.get("ok") is True and r.get("duracao_s", 0) > 5, str(r))
+
+            r = await chamar("save_draft_to_staging", draft_id=did)
+            checar("save em staging", r.get("ok") is True, str(r))
+            checar("mídias copiadas para o draft", len(r.get("midias_copiadas", [])) >= 3, str(r))
+            draft_dir = r.get("draft_dir", "")
+
+            # Regressão: o upstream carimbava .mp3/.mp4/.png fixos no nome do material
+            # (add_audio_track.py: "fixed mp3 extension"). No caminho local o arquivo é
+            # copiado byte a byte, então um .wav virava um .mp3 que mente o formato —
+            # o CapCut recebia um arquivo com extensão errada.
+            copiados = r.get("midias_copiadas", [])
+            def _asset_de(nome_origem):
+                for c in copiados:
+                    if os.path.basename(c.get("origem", "")) == nome_origem:
+                        return c.get("asset", "")
+                return ""
+            checar("asset de áudio preserva a extensão da origem (.wav)",
+                   _asset_de("audio-teste.wav").endswith(".wav"), str(copiados))
+            checar("asset de vídeo preserva a extensão da origem (.mp4)",
+                   _asset_de("video-teste.mp4").endswith(".mp4"), str(copiados))
+            checar("asset de imagem preserva a extensão da origem (.png)",
+                   _asset_de("imagem-teste.png").endswith(".png"), str(copiados))
+
+            r = await chamar("validate_draft", draft_id=did)
+            checar("validate_draft", r.get("ok") is True, str(r))
+
+            # 3. segurança — tudo tem que RECUSAR
+            r = await chamar("add_video_local", path="https://example.com/v.mp4", draft_id=did)
+            checar("URL http recusada", r.get("ok") is False and "URL" in r.get("mensagem", ""), str(r))
+
+            r = await chamar("add_video_local",
+                             path=os.path.join(ROOT, "media", "..", "CLAUDE.md"), draft_id=did)
+            checar("traversal recusado", r.get("ok") is False, str(r))
+
+            r = await chamar("add_video_local", path=r"\\servidor\share\v.mp4", draft_id=did)
+            checar("UNC recusado", r.get("ok") is False, str(r))
+
+            r = await chamar("add_video_local", path=r"C:\Windows\notepad.exe", draft_id=did)
+            checar("fora das raízes recusado", r.get("ok") is False, str(r))
+
+            r = await chamar("save_draft_to_staging", draft_id=did)
+            checar("salvar 2x o mesmo id recusado (nunca sobrescreve)",
+                   r.get("ok") is False and "sobrescrit" in r.get("mensagem", "").lower(), str(r))
+
+            r = await chamar("save_draft_to_staging", draft_id=r"VF_20260814_....\evil")
+            checar("draft_id malicioso recusado", r.get("ok") is False, str(r))
+
+            r = await chamar("publish_draft_to_capcut", draft_id=did, confirm=True)
+            checar("publish sem SAFE_CAPCUT_DRAFT_ROOT recusado",
+                   r.get("ok") is False and "SAFE_CAPCUT_DRAFT_ROOT" in r.get("mensagem", ""), str(r))
+
+            r = await chamar("publish_draft_to_capcut", draft_id=did, confirm=False)
+            checar("publish sem confirm recusado", r.get("ok") is False, str(r))
+
+            # 4. nenhuma resposta com URL externa (varremos tudo que voltou)
+            #    (as respostas acima já foram checadas uma a uma; aqui é o princípio)
+            r = await chamar("validate_draft", draft_id=did)
+            checar("resposta sem http/URL externa", "http" not in json.dumps(r).lower(), str(r)[:200])
+
+            # limpeza do draft de teste em staging
+            if draft_dir and os.path.isdir(draft_dir) and os.path.isfile(os.path.join(draft_dir, ".vf_marker.json")):
+                shutil.rmtree(draft_dir, ignore_errors=True)
+                print(f"  (staging de teste limpo: {draft_dir})")
+
+    print()
+    if FALHAS:
+        print(f"{len(FALHAS)} FALHA(S): {FALHAS}")
+        raise SystemExit(1)
+    print("roundtrip MCP completo: todos os testes passaram")
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
