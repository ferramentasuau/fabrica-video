--- a/util.py
+++ b/util.py
@@ -49,6 +49,24 @@ def zip_draft(draft_id):
     shutil.make_archive(os.path.join(zip_dir, draft_id), 'zip', os.path.join(current_dir, draft_id))
     return zip_path
 
+def material_ext(source, default):
+    """
+    Extensao do material dentro do draft, derivada da origem.
+
+    [safe-local] O upstream carimba extensao fixa (.mp3/.mp4/.png) porque no
+    fluxo dele a midia sempre chega baixada de uma URL e reescrita. No caminho
+    local seguro o arquivo e copiado byte a byte, entao a extensao precisa
+    acompanhar a origem -- senao um .wav entra no draft chamado .mp3 e o CapCut
+    recebe um arquivo que mente o proprio formato.
+
+    Quando a origem nao tiver extensao utilizavel (URL sem nome de arquivo,
+    query string), devolve o default do upstream.
+    """
+    ext = os.path.splitext(str(source))[1]
+    if not ext or len(ext) > 6 or any(c in ext for c in '/\\?&#'):
+        return default
+    return ext.lower()
+
 def url_to_hash(url, length=16):
     """
     Convert URL to a fixed-length hash string (without extension)
