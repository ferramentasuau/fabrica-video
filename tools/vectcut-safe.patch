@@ -0,0 +1,117 @@
+"""Testes de unidade do caminho seguro: kill-switch de rede e política de caminhos.
+
+Roda direto com o Python da venv (sem framework): qualquer falha = exit 1.
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+ROOT = os.environ.setdefault("VIDEO_FACTORY_ROOT", r"D:\VIDEO-FACTORY")
+os.environ.setdefault("NETWORK_DISABLED", "1")
+os.environ.setdefault("UPLOAD_DISABLED", "1")
+
+FALHAS = []
+
+
+def caso(nome, fn):
+    try:
+        fn()
+        print(f"  ok  {nome}")
+    except Exception as e:
+        FALHAS.append(f"{nome}: {e}")
+        print(f"FALHA {nome}: {e}")
+
+
+def deve_recusar(fn, *args, **kwargs):
+    from safe.paths import CaminhoRecusado
+    try:
+        fn(*args, **kwargs)
+    except CaminhoRecusado:
+        return
+    raise AssertionError("deveria ter recusado e aceitou")
+
+
+def main():
+    from safe import no_network
+    from safe.paths import carregar_config, validar_leitura, validar_draft_id, novo_draft_id
+
+    config = carregar_config()
+
+    # --- rede ---
+    no_network.install()
+
+    def t_socket():
+        import socket
+        try:
+            socket.create_connection(("example.com", 80), timeout=2)
+        except no_network.SafeNetworkError:
+            return
+        raise AssertionError("socket conectou com kill-switch instalado")
+
+    def t_requests():
+        import requests
+        try:
+            requests.get("https://example.com", timeout=2)
+        except Exception:
+            return  # qualquer exceção serve: a conexão não aconteceu
+        raise AssertionError("requests.get funcionou com kill-switch instalado")
+
+    def t_listener():
+        import socket
+        s = socket.socket()
+        try:
+            s.bind(("127.0.0.1", 9001))
+        except no_network.SafeNetworkError:
+            return
+        finally:
+            s.close()
+        raise AssertionError("bind funcionou — listener deveria ser impossível")
+
+    caso("socket de saída bloqueado", t_socket)
+    caso("requests bloqueado", t_requests)
+    caso("listener (porta 9001) bloqueado", t_listener)
+
+    # --- caminhos ---
+    video_ok = os.path.join(ROOT, "media", "test", "video-teste.mp4")
+
+    caso("arquivo válido aceito", lambda: validar_leitura(video_ok, "video", config))
+    caso("URL http recusada", lambda: deve_recusar(validar_leitura, "https://x.com/v.mp4", "video", config))
+    caso("URL ftp recusada", lambda: deve_recusar(validar_leitura, "ftp://x/v.mp4", "video", config))
+    caso("UNC recusado", lambda: deve_recusar(validar_leitura, r"\\servidor\share\v.mp4", "video", config))
+    caso("traversal .. recusado", lambda: deve_recusar(
+        validar_leitura, os.path.join(ROOT, "media", "..", "CLAUDE.md"), "video", config))
+    caso("fora das raízes recusado", lambda: deve_recusar(
+        validar_leitura, r"C:\Windows\notepad.exe", "video", config))
+    caso("dentro da raiz mas extensão errada", lambda: deve_recusar(
+        validar_leitura, os.path.join(ROOT, "media", "test", "legenda-teste.srt"), "video", config))
+    caso("caminho relativo recusado", lambda: deve_recusar(validar_leitura, "media/test/v.mp4", "video", config))
+
+    # --- draft id ---
+    caso("draft_id gerado é válido", lambda: validar_draft_id(novo_draft_id()))
+    caso("draft_id com separador recusado", lambda: deve_recusar(validar_draft_id, r"VF_20260814_..\\evil"))
+    caso("draft_id de formato livre recusado", lambda: deve_recusar(validar_draft_id, "dfd_cat_123"))
+
+    # --- config falha fechada ---
+    def t_fail_closed():
+        from safe.paths import ConfigAusente
+        salvo = os.environ.pop("NETWORK_DISABLED")
+        try:
+            carregar_config()
+        except ConfigAusente:
+            return
+        finally:
+            os.environ["NETWORK_DISABLED"] = salvo
+        raise AssertionError("config sem NETWORK_DISABLED deveria falhar")
+
+    caso("config falha fechada sem NETWORK_DISABLED", t_fail_closed)
+
+    print()
+    if FALHAS:
+        print(f"{len(FALHAS)} FALHA(S)")
+        raise SystemExit(1)
+    print("todos os testes de unidade passaram")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/util.py b/util.py
