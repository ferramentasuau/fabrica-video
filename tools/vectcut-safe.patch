+#!/usr/bin/env python3
+"""VectCut SEGURO — servidor MCP stdio para criar rascunhos do CapCut 100% local.
+
+Ordem de inicialização (não mude — é o contrato de segurança):
+  1. valida config por env (falha FECHADA se ausente);
+  2. instala o kill-switch de rede (safe/no_network.py);
+  3. só então importa os módulos de draft do upstream.
+
+Fora do processo, para sempre: capcut_server.py, mcp_server.py original,
+oss.py, downloader.py, save_draft_impl.py. Nenhuma resposta contém URL.
+Logs vão para stderr; stdout pertence ao protocolo MCP — os print() do
+upstream são redirecionados em toda chamada.
+"""
+import contextlib
+import io
+import json
+import logging
+import os
+import subprocess
+import sys
+from typing import Optional
+
+REPO_ROOT = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO_ROOT)
+
+logging.basicConfig(stream=sys.stderr, level=logging.INFO, format="[vectcut-safe] %(message)s")
+log = logging.getLogger("vectcut-safe")
+
+# ---- 1. config (falha fechada) ----
+from safe.paths import (  # noqa: E402
+    CaminhoRecusado, carregar_config, novo_draft_id, validar_draft_id, validar_leitura,
+)
+
+try:
+    CONFIG = carregar_config()
+except Exception as e:
+    print(f"[vectcut-safe] RECUSANDO INICIAR: {e}", file=sys.stderr)
+    sys.exit(2)
+
+# ---- 2. rede morta ----
+from safe import no_network  # noqa: E402
+no_network.install()
+
+# ---- 3. upstream (só os módulos locais auditados) ----
+import pyJianYingDraft as draft_lib  # noqa: E402
+from draft_cache import DRAFT_CACHE, update_cache  # noqa: E402
+from add_text_impl import add_text_impl  # noqa: E402
+from add_video_track import add_video_track  # noqa: E402
+from add_audio_track import add_audio_track  # noqa: E402
+from add_image_impl import add_image_impl  # noqa: E402
+from add_subtitle_impl import add_subtitle_impl  # noqa: E402
+from add_effect_impl import add_effect_impl  # noqa: E402
+from add_video_keyframe_impl import add_video_keyframe_impl  # noqa: E402
+from safe import draft_io  # noqa: E402
+
+from mcp.server import MCPServer  # noqa: E402
+
+mcp = MCPServer("vectcut-safe")
+
+_CONECTORES = {"e", "de", "da", "do", "das", "dos", "que", "para", "pra", "com",
+               "em", "a", "o", "as", "os", "um", "uma", "na", "no", "mas", "ou", "se", "por"}
+
+# Régua de tamanho de texto — calibrada no CapCut 9.1.0.3879, canvas 1080x1920,
+# no teste da Fase 6 (14/08/2026). O aprovador publicou cinco blocos e olhou:
+#   7  -> pequeno e minimalista (aprovado por ele como base)
+#   15 -> leitura confortável
+#   25 -> leitura forte
+#   40 -> destaque; "40 teste" (8 caracteres) enche quase toda a largura
+#   60 -> ESTOUROU a tela nos dois lados ("60 teste" saiu como "0 test")
+# Daí o limite prático: caracteres x tamanho <= ~30% da largura do canvas.
+# 8 x 40 = 320 passa raspando em 1080 (0,30 x 1080 = 324); 8 x 60 = 480 estoura.
+# É heurística de UMA fonte (a do sistema) — serve de aviso, nunca de recusa.
+_LARGURA_CANVAS = 1080
+_LIMITE_LARGURA_TEXTO = 0.30
+
+
+def _aviso_largura(texto: str, font_size: float) -> Optional[str]:
+    """Devolve aviso se o texto tende a estourar a largura; None se couber."""
+    limite = _LIMITE_LARGURA_TEXTO * _LARGURA_CANVAS
+    produto = len(texto) * float(font_size)
+    if produto <= limite:
+        return None
+    return (f"pode estourar a largura: {len(texto)} caracteres x tamanho {font_size:g} "
+            f"= {produto:g}, acima do limite ~{limite:g} medido no CapCut 9.1.0.3879 "
+            f"em 1080x1920. Reduza o tamanho ou quebre o texto.")
+
+
+def _quieto(fn, *args, **kwargs):
+    """Roda um impl do upstream com o stdout sequestrado — protege o protocolo MCP."""
+    lixo = io.StringIO()
+    with contextlib.redirect_stdout(lixo):
+        resultado = fn(*args, **kwargs)
+    ruido = lixo.getvalue().strip()
+    if ruido:
+        log.info("stdout do upstream (redirecionado): %s", ruido[:200])
+    return resultado
+
+
+def _erro(e: Exception) -> dict:
+    return {"ok": False, "erro": type(e).__name__, "mensagem": str(e)}
+
+
+def _exigir_draft(draft_id: str):
+    validar_draft_id(draft_id)
+    if draft_id not in DRAFT_CACHE:
+        raise CaminhoRecusado(
+            f"draft {draft_id} não está na sessão — crie com create_draft ou confira o id"
+        )
+    return DRAFT_CACHE[draft_id]
+
+
+def _ffprobe(caminho: str) -> dict:
+    saida = subprocess.run(
+        ["ffprobe", "-v", "error", "-print_format", "json", "-show_format", "-show_streams", caminho],
+        capture_output=True, text=True, timeout=60,
+    )
+    if saida.returncode != 0:
+        raise RuntimeError(f"ffprobe falhou: {saida.stderr[:200]}")
+    return json.loads(saida.stdout)
+
+
+def _duracao(caminho: str) -> float:
+    info = _ffprobe(caminho)
+    d = float(info.get("format", {}).get("duration", 0) or 0)
+    if d <= 0:
+        raise RuntimeError(f"não deu para medir a duração de {os.path.basename(caminho)}")
+    return d
+
+
+def _validar_janela(start: float, end: Optional[float], nome: str = "trecho"):
+    if start < 0:
+        raise CaminhoRecusado(f"{nome}: start negativo")
+    if end is not None and end <= start:
+        raise CaminhoRecusado(f"{nome}: end ({end}) precisa ser maior que start ({start})")
+
+
+# ------------------------------------------------------------------ ferramentas
+
+@mcp.tool()
+def create_draft(width: int = 1080, height: int = 1920) -> dict:
+    """Cria um rascunho novo do CapCut em memória. Devolve o draft_id (formato VF_...)."""
+    try:
+        if not (16 <= width <= 8192 and 16 <= height <= 8192):
+            raise CaminhoRecusado("resolução fora da faixa 16..8192")
+        draft_id = novo_draft_id()
+        script = draft_lib.Script_file(width, height)
+        update_cache(draft_id, script)
+        return {"ok": True, "draft_id": draft_id, "width": width, "height": height}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_video_local(path: str, draft_id: str, start: float = 0, end: Optional[float] = None,
+                    target_start: float = 0, speed: float = 1.0, volume: float = 1.0,
+                    track_name: str = "main", scale_x: float = 1.0, scale_y: float = 1.0,
+                    transform_x: float = 0, transform_y: float = 0,
+                    transition: Optional[str] = None, transition_duration: float = 0.5) -> dict:
+    """Adiciona um vídeo LOCAL (dentro das raízes permitidas) ao rascunho."""
+    try:
+        _exigir_draft(draft_id)
+        real = validar_leitura(path, "video", CONFIG)
+        _validar_janela(start, end, "vídeo")
+        if not (0.1 <= speed <= 10):
+            raise CaminhoRecusado("speed fora da faixa 0.1..10")
+        if not (0 <= volume <= 2):
+            raise CaminhoRecusado("volume fora da faixa 0..2")
+        dur = _duracao(real)
+        fim = min(end, dur) if end is not None else dur
+        _quieto(add_video_track, video_url=real, draft_id=draft_id, start=start, end=fim,
+                target_start=target_start, duration=dur, speed=speed, volume=volume,
+                track_name=track_name, scale_x=scale_x, scale_y=scale_y,
+                transform_x=transform_x, transform_y=transform_y,
+                transition=transition, transition_duration=transition_duration)
+        return {"ok": True, "draft_id": draft_id, "arquivo": os.path.basename(real),
+                "duracao_fonte_s": round(dur, 3), "trecho": [start, round(fim, 3)]}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_audio_local(path: str, draft_id: str, start: float = 0, end: Optional[float] = None,
+                    target_start: float = 0, volume: float = 1.0,
+                    track_name: str = "audio_main", speed: float = 1.0) -> dict:
+    """Adiciona um áudio LOCAL (trilha, locução ou efeito sonoro) ao rascunho."""
+    try:
+        _exigir_draft(draft_id)
+        real = validar_leitura(path, "audio", CONFIG)
+        _validar_janela(start, end, "áudio")
+        if not (0 <= volume <= 2):
+            raise CaminhoRecusado("volume fora da faixa 0..2")
+        dur = _duracao(real)
+        fim = min(end, dur) if end is not None else dur
+        _quieto(add_audio_track, audio_url=real, draft_id=draft_id, start=start, end=fim,
+                target_start=target_start, volume=volume, track_name=track_name,
+                speed=speed, duration=dur)
+        return {"ok": True, "draft_id": draft_id, "arquivo": os.path.basename(real),
+                "duracao_fonte_s": round(dur, 3)}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_image_local(path: str, draft_id: str, start: float = 0, end: float = 3.0,
+                    track_name: str = "image_overlay", scale_x: float = 1.0, scale_y: float = 1.0,
+                    transform_x: float = 0, transform_y: float = 0,
+                    animation: Optional[str] = None) -> dict:
+    """Adiciona uma imagem LOCAL ao rascunho, exibida de start a end (segundos)."""
+    try:
+        _exigir_draft(draft_id)
+        real = validar_leitura(path, "image", CONFIG)
+        _validar_janela(start, end, "imagem")
+        _quieto(add_image_impl, image_url=real, draft_id=draft_id, start=start, end=end,
+                track_name=track_name, scale_x=scale_x, scale_y=scale_y,
+                transform_x=transform_x, transform_y=transform_y, animation=animation)
+        return {"ok": True, "draft_id": draft_id, "arquivo": os.path.basename(real)}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_text(text: str, start: float, end: float, draft_id: str,
+             font_size: float = 8.0, font_color: str = "#ffffff",
+             transform_x: float = 0, transform_y: float = -0.8,
+             track_name: str = "text_main", border_width: float = 0.0,
+             border_color: str = "#000000", shadow_enabled: bool = True,
+             font: Optional[str] = None) -> dict:
+    """Adiciona texto editável ao rascunho. transform_y -1..1 (negativo = mais baixo)."""
+    try:
+        _exigir_draft(draft_id)
+        if not text or not text.strip():
+            raise CaminhoRecusado("texto vazio")
+        _validar_janela(start, end, "texto")
+        _quieto(add_text_impl, text=text, start=start, end=end, draft_id=draft_id,
+                font_size=font_size, font_color=font_color, transform_x=transform_x,
+                transform_y=transform_y, track_name=track_name, border_width=border_width,
+                border_color=border_color, shadow_enabled=shadow_enabled, font=font)
+        r = {"ok": True, "draft_id": draft_id, "texto": text[:60], "janela": [start, end]}
+        aviso = _aviso_largura(text, font_size)
+        if aviso:
+            r["aviso"] = aviso
+        return r
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_subtitle_local(srt_path: str, draft_id: str, time_offset: float = 0,
+                       font_size: float = 6.0, font_color: str = "#ffffff",
+                       transform_y: float = -0.7, track_name: str = "subtitle") -> dict:
+    """Importa um arquivo .srt LOCAL como legendas editáveis."""
+    try:
+        _exigir_draft(draft_id)
+        real = validar_leitura(srt_path, "subtitle", CONFIG)
+        _quieto(add_subtitle_impl, srt_path=real, draft_id=draft_id, time_offset=time_offset,
+                font_size=font_size, font_color=font_color, transform_y=transform_y,
+                track_name=track_name)
+        return {"ok": True, "draft_id": draft_id, "srt": os.path.basename(real)}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_dynamic_captions(draft_id: str, words: list, max_palavras: int = 4,
+                         font_size: float = 9.0, font_color: str = "#ffffff",
+                         transform_y: float = -0.55, track_name: str = "captions",
+                         font_size_destaque: Optional[float] = None) -> dict:
+    """Legenda dinâmica por páginas de sentido a partir de palavras cronometradas.
+
+    words: [{"text": str, "start": s, "end": s, "emphasis": "normal"|"keyword"}].
+    Quebra em páginas de até max_palavras, fechando sempre em pontuação forte e
+    nunca em conectivo. Sem tarja de fundo (regra da casa) — contraste via sombra.
+
+    font_size_destaque: se informado, a página que contiver uma palavra marcada
+    como "keyword" sai NESSE tamanho. Variar o tamanho entre páginas é o que dá
+    dinamismo às frases importantes — decisão do aprovador na Fase 6 (14/08/2026),
+    olhando a régua de tamanhos no CapCut. Sem ele, todas as páginas saem iguais.
+    """
+    try:
+        _exigir_draft(draft_id)
+        if not isinstance(words, list) or not words:
+            raise CaminhoRecusado("words precisa ser uma lista não vazia")
+        paginas, atual = [], []
+        for w in words:
+            t, s, e = str(w.get("text", "")).strip(), float(w.get("start", -1)), float(w.get("end", -1))
+            if not t or s < 0 or e <= s:
+                raise CaminhoRecusado(f"palavra inválida: {w}")
+            chave = str(w.get("emphasis", "normal")).lower() == "keyword"
+            atual.append((t, s, e, chave))
+            fecha_pont = t[-1] in ".!?…"
+            cheia = len(atual) >= max_palavras and t.lower().strip(".,!?…") not in _CONECTORES
+            if fecha_pont or cheia:
+                paginas.append(atual)
+                atual = []
+        if atual:
+            if len(atual) == 1 and paginas:
+                paginas[-1].extend(atual)  # órfã de 1 palavra é absorvida
+            else:
+                paginas.append(atual)
+        avisos, destacadas = [], 0
+        for pagina in paginas:
+            texto = " ".join(p[0] for p in pagina)
+            tem_chave = any(p[3] for p in pagina)
+            tamanho = font_size_destaque if (tem_chave and font_size_destaque) else font_size
+            if tem_chave and font_size_destaque:
+                destacadas += 1
+            _quieto(add_text_impl, text=texto, start=pagina[0][1], end=pagina[-1][2],
+                    draft_id=draft_id, font_size=tamanho, font_color=font_color,
+                    transform_y=transform_y, track_name=track_name,
+                    shadow_enabled=True, background_alpha=0.0)
+            aviso = _aviso_largura(texto, tamanho)
+            if aviso:
+                avisos.append(f'"{texto}" — {aviso}')
+        r = {"ok": True, "draft_id": draft_id, "paginas": len(paginas),
+             "limitacao": "destaque palavra-a-palavra dentro da página não é editável no draft; "
+                          "para destaque fino use o motor remotion"}
+        if font_size_destaque:
+            r["paginas_em_destaque"] = destacadas
+        if avisos:
+            r["avisos_de_largura"] = avisos
+        return r
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_effect(draft_id: str, effect_type: str, effect_category: str = "scene",
+               start: float = 0, end: float = 3.0, track_name: str = "effect_01") -> dict:
+    """Aplica um efeito do CapCut. effect_category: 'scene' ou 'character'."""
+    try:
+        _exigir_draft(draft_id)
+        if effect_category not in ("scene", "character"):
+            raise CaminhoRecusado("effect_category precisa ser 'scene' ou 'character'")
+        _validar_janela(start, end, "efeito")
+        try:
+            _quieto(add_effect_impl, effect_type=effect_type, effect_category=effect_category,
+                    start=start, end=end, draft_id=draft_id, track_name=track_name)
+        except (KeyError, AttributeError, ValueError) as e:
+            # correção obrigatória da SPEC: erro de catálogo vira mensagem acionável,
+            # nunca falha silenciosa
+            raise RuntimeError(
+                f"efeito '{effect_type}' não existe no catálogo {effect_category} "
+                f"da versão vendorizada ({e}) — confira o nome exato no CapCut"
+            )
+        return {"ok": True, "draft_id": draft_id, "efeito": effect_type}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def add_keyframes(draft_id: str, track_name: str = "main", property_type: str = "alpha",
+                  keyframes: Optional[list] = None) -> dict:
+    """Adiciona keyframes a um segmento. keyframes: [{"time": s, "value": "0.5"}]."""
+    try:
+        _exigir_draft(draft_id)
+        if not keyframes:
+            raise CaminhoRecusado("lista de keyframes vazia")
+        for kf in keyframes:
+            t = float(kf.get("time", -1))
+            if t < 0:
+                raise CaminhoRecusado(f"keyframe com tempo negativo: {kf}")
+            _quieto(add_video_keyframe_impl, draft_id=draft_id, track_name=track_name,
+                    property_type=property_type, time=t, value=str(kf.get("value", "1.0")))
+        return {"ok": True, "draft_id": draft_id, "keyframes": len(keyframes)}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def inspect_media(path: str) -> dict:
+    """Lê metadados técnicos (ffprobe) de uma mídia LOCAL dentro das raízes permitidas."""
+    try:
+        real = None
+        for tipo in ("video", "audio", "image"):
+            try:
+                real = validar_leitura(path, tipo, CONFIG)
+                break
+            except CaminhoRecusado as e:
+                ultimo = e
+        if real is None:
+            raise ultimo
+        info = _ffprobe(real)
+        fmt = info.get("format", {})
+        streams = [{
+            "tipo": s.get("codec_type"), "codec": s.get("codec_name"),
+            "largura": s.get("width"), "altura": s.get("height"),
+            "sample_rate": s.get("sample_rate"), "canais": s.get("channels"),
+        } for s in info.get("streams", [])]
+        return {"ok": True, "arquivo": os.path.basename(real),
+                "duracao_s": float(fmt.get("duration", 0) or 0),
+                "tamanho_bytes": int(fmt.get("size", 0) or 0), "streams": streams}
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def save_draft_to_staging(draft_id: str) -> dict:
+    """Materializa o rascunho em staging\\<draft_id>. Nunca sobrescreve destino."""
+    try:
+        script = _exigir_draft(draft_id)
+        return draft_io.salvar_em_staging(draft_id, script, CONFIG, REPO_ROOT)
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def validate_draft(draft_id: str) -> dict:
+    """Valida a estrutura do rascunho salvo em staging (JSONs, assets, marker)."""
+    try:
+        return draft_io.validar_draft(draft_id, CONFIG)
+    except Exception as e:
+        return _erro(e)
+
+
+@mcp.tool()
+def publish_draft_to_capcut(draft_id: str, confirm: bool = False) -> dict:
+    """Publica um draft validado na pasta real do CapCut. TRAVADO até a Fase 6:
+    exige SAFE_CAPCUT_DRAFT_ROOT no ambiente, confirm=true, CapCut fechado,
+    destino inexistente e backup automático. Nunca sobrescreve nada."""
+    try:
+        script = DRAFT_CACHE.get(draft_id)
+        backups = os.path.join(CONFIG["root"], "backups", "capcut")
+        return draft_io.publicar_no_capcut(draft_id, script, CONFIG, confirm, backups)
+    except Exception as e:
+        return _erro(e)
+
+
+if __name__ == "__main__":
+    log.info("iniciando (stdio) — raiz=%s staging=%s", CONFIG["root"], CONFIG["staging"])
+    mcp.run()
