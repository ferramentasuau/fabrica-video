diff --git a/safe/draft_io.py b/safe/draft_io.py
new file mode 100644
index 0000000..347084c
--- /dev/null
+++ b/safe/draft_io.py
@@ -0,0 +1,234 @@
+"""Gravação, validação e publicação de drafts — reimplementação segura.
+
+Substitui save_draft_impl.py do upstream, que: (1) apaga destino existente com
+rmtree, (2) baixa mídia da internet em ThreadPool, (3) sobe zip para OSS e
+(4) consulta um endpoint remoto. Aqui: destino existente = ERRO, mídia é
+sempre cópia local, e publicação no CapCut é operação separada com trava.
+"""
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+from datetime import datetime
+
+from .paths import CaminhoRecusado, validar_draft_id
+
+MARKER = ".vf_marker.json"
+
+
+class DraftErro(RuntimeError):
+    pass
+
+
+def _log(msg: str) -> None:
+    print(f"[draft_io] {msg}", file=sys.stderr)
+
+
+def _sha256(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for bloco in iter(lambda: f.read(1 << 20), b""):
+            h.update(bloco)
+    return h.hexdigest()
+
+
+def _tipo_asset(material) -> str:
+    mt = getattr(material, "material_type", "")
+    if mt == "photo":
+        return "image"
+    if mt == "video":
+        return "video"
+    return "audio"
+
+
+def _materiais(script):
+    for video in getattr(script.materials, "videos", []) or []:
+        yield video
+    for audio in getattr(script.materials, "audios", []) or []:
+        yield audio
+
+
+def salvar_em_staging(draft_id: str, script, config: dict, repo_root: str) -> dict:
+    """Materializa o draft do cache em staging\\<draft_id>. Nunca sobrescreve."""
+    validar_draft_id(draft_id)
+    from draft_profiles import get_draft_profile, write_profile_content
+
+    staging = config["staging"]
+    os.makedirs(staging, exist_ok=True)
+    draft_dir = os.path.join(staging, draft_id)
+    if os.path.exists(draft_dir):
+        raise DraftErro(
+            f"destino já existe e NÃO será sobrescrito: {draft_dir} — gere um novo draft_id"
+        )
+
+    profile = get_draft_profile()
+    template_src = os.path.join(repo_root, profile.template_dir)
+    if not os.path.isdir(template_src):
+        raise DraftErro(f"template do perfil não encontrado: {template_src}")
+
+    try:
+        shutil.copytree(template_src, draft_dir)
+
+        copiados = []
+        for material in _materiais(script):
+            origem = getattr(material, "remote_url", None)
+            if not origem:
+                continue  # material sem arquivo (ex.: texto)
+            if not os.path.isfile(origem):
+                raise DraftErro(f"mídia registrada no draft sumiu do disco: {origem}")
+            tipo = _tipo_asset(material)
+            nome = material.material_name
+            destino = os.path.join(draft_dir, "assets", tipo, nome)
+            os.makedirs(os.path.dirname(destino), exist_ok=True)
+            shutil.copy2(origem, destino)
+            material.replace_path = destino
+            copiados.append({
+                "origem": origem,
+                "asset": os.path.relpath(destino, draft_dir),
+                "bytes": os.path.getsize(destino),
+            })
+
+        escritos = write_profile_content(profile, draft_dir, script.dumps(profile))
+
+        with open(os.path.join(draft_dir, MARKER), "w", encoding="utf-8") as f:
+            json.dump({
+                "draft_id": draft_id,
+                "criado_em": datetime.now().isoformat(timespec="seconds"),
+                "ferramenta": "vectcut-safe",
+                "perfil": profile.template_dir,
+            }, f, ensure_ascii=False, indent=2)
+
+        return {
+            "ok": True,
+            "draft_dir": draft_dir,
+            "arquivos_de_conteudo": [os.path.relpath(str(p), draft_dir) for p in escritos],
+            "midias_copiadas": copiados,
+        }
+    except Exception:
+        # rollback: só removemos o que ESTA execução criou agora
+        if os.path.isdir(draft_dir):
+            shutil.rmtree(draft_dir, ignore_errors=True)
+        raise
+
+
+def validar_draft(draft_id: str, config: dict) -> dict:
+    validar_draft_id(draft_id)
+    draft_dir = os.path.join(config["staging"], draft_id)
+    problemas = []
+    if not os.path.isdir(draft_dir):
+        raise DraftErro(f"draft não existe em staging: {draft_dir}")
+    if not os.path.isfile(os.path.join(draft_dir, MARKER)):
+        problemas.append("sem marker do vectcut-safe (não foi criado por este fluxo)")
+
+    conteudos = []
+    for raiz, _dirs, arquivos in os.walk(draft_dir):
+        for nome in arquivos:
+            if nome.endswith(".json") and nome != MARKER:
+                caminho = os.path.join(raiz, nome)
+                if os.path.getsize(caminho) == 0:
+                    continue  # placeholder vazio que já vem no template do upstream
+                try:
+                    with open(caminho, "r", encoding="utf-8") as f:
+                        json.load(f)
+                    conteudos.append(os.path.relpath(caminho, draft_dir))
+                except Exception as e:
+                    problemas.append(f"JSON inválido: {nome} ({e})")
+
+    n_assets = 0
+    pasta_assets = os.path.join(draft_dir, "assets")
+    if os.path.isdir(pasta_assets):
+        for raiz, _dirs, arquivos in os.walk(pasta_assets):
+            for nome in arquivos:
+                n_assets += 1
+                if os.path.getsize(os.path.join(raiz, nome)) == 0:
+                    problemas.append(f"asset vazio: {nome}")
+
+    return {
+        "ok": not problemas,
+        "draft_dir": draft_dir,
+        "jsons_validos": conteudos,
+        "assets": n_assets,
+        "problemas": problemas,
+    }
+
+
+def _capcut_aberto() -> bool:
+    try:
+        saida = subprocess.run(
+            ["tasklist", "/FI", "IMAGENAME eq CapCut.exe", "/FO", "CSV", "/NH"],
+            capture_output=True, text=True, timeout=10,
+        ).stdout
+        return "CapCut.exe" in saida
+    except Exception:
+        # na dúvida, tratamos como aberto: publicar com o CapCut aberto é proibido
+        return True
+
+
+def publicar_no_capcut(draft_id: str, script, config: dict, confirmar: bool, backups_dir: str) -> dict:
+    """Operação especial da Fase 6 — todas as travas da SPEC, na ordem."""
+    validar_draft_id(draft_id)
+
+    capcut_root = os.environ.get("SAFE_CAPCUT_DRAFT_ROOT", "").strip()
+    if not capcut_root:
+        raise DraftErro(
+            "publicação bloqueada: SAFE_CAPCUT_DRAFT_ROOT não configurado. "
+            "Essa variável só entra na Fase 6, com o caminho aprovado pelo aprovador na conversa."
+        )
+    if not os.path.isdir(capcut_root):
+        raise DraftErro(f"pasta de projetos do CapCut não existe: {capcut_root}")
+    if confirmar is not True:
+        raise DraftErro("publicação exige confirm=true explícito (regra 9 da SPEC)")
+
+    relatorio_validacao = validar_draft(draft_id, config)
+    if not relatorio_validacao["ok"]:
+        raise DraftErro(f"draft inválido, não publica: {relatorio_validacao['problemas']}")
+    if script is None:
+        raise DraftErro(
+            "script fora do cache — publique na mesma sessão em que o draft foi salvo "
+            "(o re-dump dos caminhos finais depende do draft em memória)"
+        )
+    if _capcut_aberto():
+        raise DraftErro("CapCut está aberto — feche o CapCut e chame de novo (regra da Fase 6)")
+
+    origem = os.path.join(config["staging"], draft_id)
+    destino = os.path.join(capcut_root, draft_id)
+    if os.path.exists(destino):
+        raise DraftErro(f"já existe um projeto com esse nome no CapCut: {destino} — nada foi tocado")
+
+    # backup do draft de staging (recuperável mesmo se algo der errado depois)
+    os.makedirs(backups_dir, exist_ok=True)
+    backup_zip = shutil.make_archive(
+        os.path.join(backups_dir, f"{draft_id}-{datetime.now().strftime('%H%M%S')}"),
+        "zip", origem,
+    )
+
+    criado = False
+    try:
+        shutil.copytree(origem, destino)
+        criado = True
+
+        # re-dump com os caminhos FINAIS (o draft precisa apontar para onde vai morar)
+        from draft_profiles import get_draft_profile, write_profile_content
+        profile = get_draft_profile()
+        for material in _materiais(script):
+            if getattr(material, "replace_path", None):
+                material.replace_path = os.path.join(
+                    destino, "assets", _tipo_asset(material), material.material_name
+                )
+        escritos = write_profile_content(profile, destino, script.dumps(profile))
+
+        hashes = {os.path.relpath(str(p), destino): _sha256(str(p)) for p in escritos}
+        return {
+            "ok": True,
+            "publicado_em": destino,
+            "backup": backup_zip,
+            "hashes_conteudo": hashes,
+            "aviso": "abra o CapCut e confira o projeto; os projetos antigos não foram tocados",
+        }
+    except Exception:
+        # rollback simples: remove só o que nós criamos agora
+        if criado and os.path.isdir(destino):
+            shutil.rmtree(destino, ignore_errors=True)
+        raise
diff --git a/safe/no_network.py b/safe/no_network.py
new file mode 100644
index 0000000..3944a1d
--- /dev/null
+++ b/safe/no_network.py
@@ -0,0 +1,98 @@
+"""Kill-switch de rede do VectCut seguro.
+
+Instalado ANTES de qualquer import dos módulos do upstream. Mesmo que algum
+módulo importe `requests` (add_subtitle_impl importa), conexão real falha
+fechada aqui, na camada de socket.
+
+Exceção deliberada e mínima: o asyncio do Windows (ProactorEventLoop) cria um
+self-pipe interno via socketpair — bind em 127.0.0.1 com porta 0 (efêmera) e
+connect de volta ao próprio loopback. Isso nunca sai da máquina e não abre
+serviço alcançável de fora. Então: LOOPBACK com porta EFÊMERA passa; qualquer
+host externo, e qualquer porta FIXA (9001 incluída), morre.
+"""
+import socket
+
+_LOOPBACK = {"127.0.0.1", "::1", "localhost", ""}
+
+
+class SafeNetworkError(OSError):
+    pass
+
+
+_MENSAGEM = (
+    "rede desabilitada: o VectCut seguro opera 100% local "
+    "(regra absoluta 4 da SPEC — nenhum dado sai da máquina)"
+)
+
+_instalado = False
+
+
+def _host_de(address) -> str:
+    if isinstance(address, tuple) and address:
+        return str(address[0]).lower()
+    return str(address).lower()
+
+
+def _porta_de(address):
+    if isinstance(address, tuple) and len(address) >= 2:
+        try:
+            return int(address[1])
+        except (TypeError, ValueError):
+            return None
+    return None
+
+
+def install() -> None:
+    global _instalado
+    if _instalado:
+        return
+
+    orig_connect = socket.socket.connect
+    orig_connect_ex = socket.socket.connect_ex
+    orig_bind = socket.socket.bind
+    orig_getaddrinfo = socket.getaddrinfo
+
+    def connect_seguro(self, address):
+        if _host_de(address) in _LOOPBACK:
+            return orig_connect(self, address)
+        raise SafeNetworkError(_MENSAGEM)
+
+    def connect_ex_seguro(self, address):
+        if _host_de(address) in _LOOPBACK:
+            return orig_connect_ex(self, address)
+        raise SafeNetworkError(_MENSAGEM)
+
+    def bind_seguro(self, address):
+        # só loopback + porta efêmera (0): é o self-pipe do asyncio.
+        # Porta fixa (9001 etc.) é serviço — proibido pela regra 3.
+        if _host_de(address) in _LOOPBACK and _porta_de(address) == 0:
+            return orig_bind(self, address)
+        raise SafeNetworkError(_MENSAGEM)
+
+    def getaddrinfo_seguro(host, *args, **kwargs):
+        if host is None or str(host).lower() in _LOOPBACK:
+            return orig_getaddrinfo(host, *args, **kwargs)
+        raise SafeNetworkError(_MENSAGEM)
+
+    socket.socket.connect = connect_seguro
+    socket.socket.connect_ex = connect_ex_seguro
+    socket.socket.bind = bind_seguro
+    socket.getaddrinfo = getaddrinfo_seguro
+    socket.create_connection = _create_connection_segura(orig_getaddrinfo)
+
+    _instalado = True
+
+
+def _create_connection_segura(orig_getaddrinfo):
+    def _impl(address, *args, **kwargs):
+        if _host_de(address) in _LOOPBACK:
+            # reconstrução mínima: loopback direto, sem passar pelo getaddrinfo bloqueado
+            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            s.connect((address[0] if address[0] else "127.0.0.1", address[1]))
+            return s
+        raise SafeNetworkError(_MENSAGEM)
+    return _impl
+
+
+def esta_instalado() -> bool:
+    return _instalado
diff --git a/safe/paths.py b/safe/paths.py
new file mode 100644
index 0000000..7694653
--- /dev/null
+++ b/safe/paths.py
@@ -0,0 +1,125 @@
+"""Política de caminhos do VectCut seguro.
+
+Leitura só dentro das raízes permitidas; escrita normal só em staging.
+Falha FECHADA: sem as variáveis de ambiente obrigatórias, nada funciona —
+o oposto do settings/local.py do upstream, que silenciosamente cai em
+defaults com domínio remoto.
+"""
+import os
+import re
+import uuid
+from datetime import datetime
+
+ENV_ROOT = "VIDEO_FACTORY_ROOT"
+ENV_MEDIA = "MEDIA_ROOT"
+ENV_STAGING = "STAGING_ROOT"
+ENV_NETWORK = "NETWORK_DISABLED"
+ENV_UPLOAD = "UPLOAD_DISABLED"
+ENV_CAPCUT = "SAFE_CAPCUT_DRAFT_ROOT"  # só existe depois da aprovação da Fase 6
+
+EXTENSOES = {
+    "video": {".mp4", ".mov", ".m4v", ".avi", ".mkv", ".webm"},
+    "audio": {".wav", ".mp3", ".m4a", ".aac", ".flac"},
+    "image": {".png", ".jpg", ".jpeg", ".webp", ".bmp"},
+    "subtitle": {".srt"},
+    "json": {".json"},
+}
+
+TAMANHO_MAX_MB = int(os.environ.get("SAFE_MAX_FILE_MB", "2048"))
+
+_RE_ESQUEMA = re.compile(r"^[A-Za-z][A-Za-z0-9+.\-]*://")
+_RE_DRAFT_ID = re.compile(r"^VF_\d{8}_[a-f0-9]{8}$")
+
+
+class CaminhoRecusado(ValueError):
+    pass
+
+
+class ConfigAusente(RuntimeError):
+    pass
+
+
+def _env_obrigatoria(nome: str) -> str:
+    valor = os.environ.get(nome, "").strip()
+    if not valor:
+        raise ConfigAusente(
+            f"variável {nome} ausente — o servidor seguro falha fechado sem configuração explícita"
+        )
+    return valor
+
+
+def carregar_config() -> dict:
+    """Valida o ambiente na inicialização. Levanta ConfigAusente se faltar algo."""
+    root = _env_obrigatoria(ENV_ROOT)
+    if _env_obrigatoria(ENV_NETWORK) != "1":
+        raise ConfigAusente(f"{ENV_NETWORK} precisa ser '1' — rede é proibida no caminho seguro")
+    if _env_obrigatoria(ENV_UPLOAD) != "1":
+        raise ConfigAusente(f"{ENV_UPLOAD} precisa ser '1' — upload é proibido no caminho seguro")
+    if not os.path.isdir(root):
+        raise ConfigAusente(f"{ENV_ROOT} não existe no disco: {root}")
+
+    media = os.environ.get(ENV_MEDIA, "").strip() or os.path.join(root, "media")
+    staging = os.environ.get(ENV_STAGING, "").strip() or os.path.join(root, "staging")
+
+    leitura = [
+        media,
+        os.path.join(root, "jobs"),
+        os.path.join(root, "presets"),
+        os.path.join(root, "assets", "generated"),
+    ]
+    return {
+        "root": os.path.realpath(root),
+        "leitura": [os.path.realpath(p) for p in leitura],
+        "staging": os.path.realpath(staging),
+    }
+
+
+def _dentro(caminho_real: str, raiz: str) -> bool:
+    raiz_norm = os.path.normcase(raiz.rstrip("\\/"))
+    alvo = os.path.normcase(caminho_real)
+    return alvo == raiz_norm or alvo.startswith(raiz_norm + os.sep)
+
+
+def validar_leitura(caminho, tipo: str, config: dict) -> str:
+    """Valida um caminho de mídia de ENTRADA. Devolve o caminho real ou levanta CaminhoRecusado."""
+    if not isinstance(caminho, str) or not caminho.strip() or "\x00" in caminho:
+        raise CaminhoRecusado("caminho vazio ou inválido")
+    bruto = caminho.strip()
+
+    if _RE_ESQUEMA.match(bruto) or bruto.lower().startswith(("http:", "https:", "ftp:", "file:")):
+        raise CaminhoRecusado(f"URL recusada ({bruto[:60]}) — só arquivo local é aceito (regra 5)")
+    if bruto.startswith("\\\\") or bruto.startswith("//"):
+        raise CaminhoRecusado("caminho UNC recusado")
+    if ".." in bruto.replace("/", "\\").split("\\"):
+        raise CaminhoRecusado("'..' no caminho recusado")
+    if not os.path.isabs(bruto):
+        raise CaminhoRecusado("caminho relativo recusado — use caminho absoluto dentro das raízes permitidas")
+
+    real = os.path.realpath(bruto)  # resolve symlink/junction; escapar da raiz = recusa abaixo
+    if not any(_dentro(real, raiz) for raiz in config["leitura"]):
+        raise CaminhoRecusado(
+            f"fora das raízes permitidas: {real} (permitidas: {', '.join(config['leitura'])})"
+        )
+    if not os.path.isfile(real):
+        raise CaminhoRecusado(f"arquivo não existe: {real}")
+
+    ext = os.path.splitext(real)[1].lower()
+    if tipo not in EXTENSOES or ext not in EXTENSOES[tipo]:
+        raise CaminhoRecusado(f"extensão {ext} não permitida para {tipo}")
+
+    tamanho_mb = os.path.getsize(real) / (1024 * 1024)
+    if tamanho_mb > TAMANHO_MAX_MB:
+        raise CaminhoRecusado(f"arquivo de {tamanho_mb:.0f} MB excede o limite de {TAMANHO_MAX_MB} MB")
+    return real
+
+
+def validar_draft_id(draft_id) -> str:
+    if not isinstance(draft_id, str) or not _RE_DRAFT_ID.match(draft_id):
+        raise CaminhoRecusado(
+            "draft_id inválido — formato exigido: VF_AAAAMMDD_<8 hex> (sem separadores de caminho)"
+        )
+    return draft_id
+
+
+def novo_draft_id() -> str:
+    return f"VF_{datetime.now().strftime('%Y%m%d')}_{uuid.uuid4().hex[:8]}"
